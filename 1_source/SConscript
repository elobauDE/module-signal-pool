    def vcast_builder(env, target, source):
        env['ENV']['WORKSPACE'] = PROJECT_VCAST_WORKDIR
        env['ENV']['SRC_DIR1'] = PROJECT_INCLUDE.replace(SOURCE_FOLDER, '')
        env['ENV']['VECTOR_LICENSE_FILE'] = '27000@vm-tool2'
