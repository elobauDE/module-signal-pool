            if (tool_name != 'parasoft') and (tool_name != 'compiler'):
                if os.path.exists(tool_server_dir) == True:
                    print("Copying ... ", end = '')
                    shutil.copytree(tool_server_dir, tool_user_dir)
                else:
                    print("Tool not found, install manually ... ", end = '')
                    failure = 1

        # Print Tool Version
        print(tool_ver)

if failure == 1:
    time_end = time.time()
    print("Checking tool versions failed (" + str(round((time_end - time_start),1)) + "s)")
    Exit(2)

