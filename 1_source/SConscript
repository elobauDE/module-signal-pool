        if os.path.isdir(path_armcc):
            print(f'Using armcc compiler version \'{COMPILER_VERSION}\' in path \'{path_armcc}\'')
        else:
            print(f'path: {path_armcc} does not exist, using default compiler in path \'{tool_custom_path}/ARM/ARMCLANG_{COMPILER_VERSION}/bin/\'')
            path_armcc = f'{tool_custom_path}/ARM/ARMCLANG_{COMPILER_VERSION}/bin/'
        # Jenkins UUID
        if env['BUILD_MACHINE'] == 'jenkins':
            parasoft = f'{parasoft_path}/bin/cpptestscan --cpptestscanOutputFile=cpptest.bdf --cpptestscanProjectName={PROJECT_TARGET} '
        else:
            if (BUILD_TARGET == 'vcast' or
                BUILD_TARGET == 'full' or
                BUILD_TARGET == 'release'):
                print('Builder full or vcast or release')
                parasoft = f'{vcast_path}/vcshell --db={VCAST_FOLDER}/{PROJECT_TARGET}.db -- '
            else:
                print('build')
                parasoft = ''

        #Configure PATH
        env.PrependENVPath('PATH', path_armcc)
        env.PrependENVPath('PATH', tool_custom_path + '/UV4')

        # Configure Compiler
        env['AR'] = parasoft + path_armcc + 'armar'
        env['AS'] = parasoft + path_armcc + 'ArmClang'
        env['CC'] = parasoft + path_armcc + 'ArmClang'
        print('Compiler: ')
        print(env['CC'])
        env['LINK'] = parasoft + path_armcc + 'armlink'
        env[tool_name] = tool_custom_path
    elif env['tools'][tool][2] != '':
        env[tool_name] = tool_custom_path
        env.PrependENVPath('PATH', tool_custom_path)
    else:
        env[tool_name] = path_common
        env.PrependENVPath('PATH', path_common)

