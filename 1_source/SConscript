        env['ENV']['path'] = '%VECTORCAST_DIR%\\MinGW\\bin;C:\\Program Files\\eclipse\\doxygen_1a;%path%'
        env['ENV']['VCAST_RPTS_PRETTY_PRINT_HTML'] = 'FALSE'
        env['ENV']['VCAST_RPTS_SELF_CONTAINED'] = 'TRUE'
        WAIT_LOOP_CNT = '6'
        WAIT_TIME_SECS = '120'
        env['ENV']['VCAST_REPORT'] = PROJECT_BUILD
        PROJECT_PREFIX = f'{PROJECT_BUILD}\\{PROJECT_TARGET}'
        VCAST_SRC_DIR = f'{vcast_path}\\vpython {VCAST_FOLDER}\\vc_scripts\\'
        VCM_FILE = f'{PROJECT_VCAST_WORKDIR}\\{PROJECT_TARGET}_project.vcm'
        # Delete and build VCast vcshell database if module tests exist
        #Execute(Delete(f'{VCAST_FOLDER}/{PROJECT_TARGET}.db'))
        #commandToRun = f'{vcast_path}\\vcshell c:\\Keil_v5\\UV4\\uv4.exe -r -j0 -l build.log {PROJECT_SOURCE}\\{PROJECT_TARGET}.uvprojx --db={VCAST_FOLDER}/{PROJECT_TARGET}.db'
        #print('Running: ' + commandToRun)
        #subprocess.call (commandToRun)
        composed_manage = f'{VCAST_SRC_DIR}managewait.py --wait_time {WAIT_TIME_SECS} --wait_loops {WAIT_LOOP_CNT} --command_line "--project {VCM_FILE} '
        composed_junit = f'{VCAST_SRC_DIR}generate-results.py --junit --wait_time {WAIT_TIME_SECS} --wait_loops {WAIT_LOOP_CNT} "{VCM_FILE}" --buildlog complete_build.log'
        composed_cobertura = f'{VCAST_SRC_DIR}cobertura.py {VCM_FILE}'
        # This is a list of steps to compile and run the tests with managewait.py and generate-results.
        vcast_steps = [[composed_manage, '--status"'],
                       [composed_manage, '--force --release-locks "'],
                       [composed_manage, '--config VCAST_CUSTOM_REPORT_FORMAT=HTML"'],
                       ['del command.log > nul 2>&1', ''],
                       [composed_manage, '--build-execute --incremental --output ' +  PROJECT_PREFIX + '_rebuild.html"'],
                       ['copy command.log complete_build.log', ''],
                       ['copy ', PROJECT_PREFIX + '_rebuild.html ' + PROJECT_PREFIX + '_rebuild.html_tmp'],
                       [composed_junit, ''],
                       [VCAST_SRC_DIR + 'full_report_no_toc.py ', VCM_FILE],
                       [VCAST_SRC_DIR + 'fixup_reports.py ', PROJECT_PREFIX + '_rebuild.html_tmp'],
                       [composed_manage, '--full-status=' + PROJECT_PREFIX + '_full_report.html"'],
                       [composed_manage, '--create-report=aggregate   --output=' + PROJECT_PREFIX + '_aggregate_report.html"'],
                       [composed_manage, '--create-report=metrics     --output=' + PROJECT_PREFIX + '_metrics_report.html"'],
                       [composed_manage, '--create-report=environment --output=' + PROJECT_PREFIX + '_environment_report.html"'],
                       [composed_cobertura, '']]
        for step_cmd in vcast_steps:
            _cmd, _parameter = step_cmd
            env.Execute(_cmd + _parameter)
    if MODULE_TESTS:
        print('Running VCAST Module Tests')
        vcast = env.Command([PROJECT_TARGET + '_aggregate_report.html', PROJECT_TARGET + '_metrics_report.html', PROJECT_TARGET +'_environment_report.html', PROJECT_TARGET +'_project_full_report.html'],
