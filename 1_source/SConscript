for tool in range(len(env['tools'])):
    tool_name = env['tools'][tool][0]
    tool_ver = env['tools'][tool][1]
    tool_ver_file = tool_ver.replace('.','_')
    tool_custom_path = env['tools'][tool][2]
    path_common = env['USERTOOLDIR'] + tool_name + '/' + tool_ver_file
    if tool_name == 'parasoft':
        parasoft_path = tool_custom_path
    if tool_name == 'keil':
        build_target = BUILD_TARGET
        prj_target = PROJECT_TARGET

        path_armcc = f'{tool_custom_path}/ARM/ARMCLANG_{COMPILER_VERSION}/bin/'
        if os.path.isdir(path_armcc):
            print(f'Using armcc compiler version \'{COMPILER_VERSION}\' in path \'{path_armcc}\'')
        else:
            print(f'path: {path_armcc} does not exist, using default compiler in path \'{tool_custom_path}/ARM/ARMCLANG_{COMPILER_VERSION}/bin/\'')
            path_armcc = f'{tool_custom_path}/ARM/ARMCLANG_{COMPILER_VERSION}/bin/'
        # Jenkins UUID
        if env['BUILD_MACHINE'] == 'jenkins':
            parasoft = f'{parasoft_path}/bin/cpptestscan --cpptestscanOutputFile=cpptest.bdf --cpptestscanProjectName={PROJECT_TARGET} '
        else:
            parasoft = ''


        #Configure PATH
        env.PrependENVPath('PATH', path_armcc)
        env.PrependENVPath('PATH', tool_custom_path + '/UV4')

        # Configure Compiler
        env['AR'] = parasoft + path_armcc + 'armar'
        env['AS'] = parasoft + path_armcc + 'armclang'
        env['CC'] = parasoft + path_armcc + 'armclang'
        env['LINK'] = parasoft + path_armcc + 'armlink'
        env[tool_name] = tool_custom_path
    elif env['tools'][tool][2] != '':
        env[tool_name] = tool_custom_path
        env.PrependENVPath('PATH', tool_custom_path)
    else:
        env[tool_name] = path_common
        env.PrependENVPath('PATH', path_common)

time_end = time.time()
if failure == 0:
    print("Configuration finished successfully in " + str(round((time_end - time_start),1)) + "s")
    env.Append(ENV = {'PATH' : os.environ['PATH']})
else:
    print("Configuration failed after " + str(round((time_end - time_start),1)) + "s")

#####
# Output scons log
#####
f_log=open("buildlog.txt", "w")

# need an Environment and a matching buffered_spawn API .. encapsulate
class idBuffering:
    def buffered_spawn(self, sh, escape, cmd, args, env):
        stderr = StringIO()
        stdout = StringIO()
        command_string = ""
        for i in args:
            if len(command_string):
                command_string += " "
            command_string += i
        try:
            retval = self.env["PSPAWN"](sh, escape, cmd, args, env, stdout, stderr)
        except OSError as x:
            if x.errno != 10:
                raise x
            print("OSError ignored on command: %s" % command_string)
            retval = 0
        std_out = stdout.getvalue()
        std_err = stderr.getvalue()
        f_log.write(command_string + '\n')
        f_log.write(std_out)
        f_log.write(std_err)
        f_log.flush()
        os.fsync(f_log)
        sys.stdout.write(std_out)
        sys.stderr.write(std_err)
        return retval


# get a clean error output when running multiple jobs
def SetupBufferedOutput(env):
    buf = idBuffering()
    buf.env = env
    env["SPAWN"] = buf.buffered_spawn

# Setup Tools
SetupBufferedOutput(env)

#####
# Project Version
#####
def project_version_action(target, source, env):
    if (APP_MAJOR == 0 and
        APP_MINOR == 0 and
        APP_DEVEL == 0 and
        APP_BUILD == 0):
        version.versions(VERSiON_FILE, VERSiON_FILE, 1)
    else:
        version.versions(VERSiON_FILE, VERSiON_FILE, 3,
        APP_MAJOR, APP_MINOR, APP_DEVEL, APP_BUILD)
    return 0

