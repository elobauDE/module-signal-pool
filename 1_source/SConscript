# Check that C:/Tools exists
if os.path.exists('C:\\Tools') == False:
    os.mkdir('C:\\Tools')

for tool in range(len(env['tools'])):
    if env['tools'][tool][0]== 'compiler':
        COMPILER_VERSION = env['tools'][tool][1]
    else:
        tool_name = env['tools'][tool][0]
        tool_ver = env['tools'][tool][1]
        tool_ver_file = tool_ver.replace('.','_')
        tool_custom_path = env['tools'][tool][2]

        print("Checking for " + tool_name + " ... ", end = '')

        # clean toolname
        tool_server_dir = env['SERVERTOOLDIR'] + '/' + tool_name + '/' + tool_ver_file
        if env['tools'][tool][2] == '':
            tool_user_dir = env['USERTOOLDIR'] + tool_name + '/' + tool_ver_file
        else:
            # tool must be manually installed
            tool_user_dir = tool_custom_path


        #check if tool exists
        if os.path.exists(tool_user_dir) == False:
            if (tool_name != 'parasoft') & (tool_name != 'compiler'):
                if os.path.exists(tool_server_dir) == True:
                    print("Copying ... ", end = '')
                    shutil.copytree(tool_server_dir, tool_user_dir)
                else:
                    print("Tool not found, install manually ... ", end = '')
                    failure = 1

        # Print Tool Version
        print(tool_ver)

if failure == 1:
    time_end = time.time()
    print("Checking tool versions failed (" + str(round((time_end - time_start),1)) + "s)")
    Exit(2)

#############################################################################
## Configure Tools in Environment
